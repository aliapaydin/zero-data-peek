<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ZeroDataPeek.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Marka renkleri: Zero ailesiyle ortak (bkz. docs/DESIGN.md) -->
            <SolidColorBrush x:Key="ZeroBlueBrush" Color="#1F6FD6" />
            <SolidColorBrush x:Key="SignalAmberBrush" Color="#F2B84B" />

            <!-- Zeminsiz, kenarlıksız düğme (araç ve durum çubuğu) -->
            <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
